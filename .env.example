# 开发 / 测试专用云 API（Agent 与脚本使用）。
# 复制为 .env 后填写；.env 已被 .gitignore 排除，勿提交。
# 这是给开发期 Agent/自动化测试的凭据，与终端用户在应用设置里配置的
# ai-provider.json 是两套独立配置，不要互相写入或混用。
# 建议在服务商后台为此 Key 设置额度上限，泄露时只吊销这一枚。

# OpenAI-compatible 端点（通常以 /v1 结尾）
INKSTONE_AI_BASE_URL=https://api.example.com/v1

# 测试专用模型名
INKSTONE_AI_MODEL=

# API Key（仅存在于本地 .env，永不入库、永不写入 Markdown/session.json）
INKSTONE_AI_API_KEY=
